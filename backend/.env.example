# PostgreSQL + PostGIS
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sih26089?schema=public"

# Server
PORT=4000
NODE_ENV=development

# JWT
JWT_ACCESS_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Fairness / wage-split constants (Part F)
EMERGENCY_SURGE_PERCENT=0.20
FEDERATION_FEE_PERCENT=0.10
WELFARE_PERCENT=0.03

# Razorpay (test mode). If unset, payment order creation falls back to a
# mock order (see payment.controller.ts) so the booking->pay->rate flow is
# still testable end to end without a real Razorpay test account.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI service. Use 127.0.0.1, not localhost, for local (non-Docker) dev —
# "localhost" can resolve to the IPv6 ::1 first on some machines, and
# `uvicorn --host 0.0.0.0` only binds IPv4, so that resolution order
# causes an ECONNREFUSED that has nothing to do with the service being
# down. Inside docker-compose this is a service name (ai-service), not
# localhost, so it isn't affected.
AI_SERVICE_URL=http://127.0.0.1:8000
